  },
  "homepage": "https://github.com/patohed/wedding-day",
  "repository": {
    "type": "git",
    "url": "https://github.com/patohed/wedding-day.git"
  },
  "bugs": {
    "url": "https://github.com/patohed/wedding-day/issues"
  },
  "keywords": [
    "wedding",
    "invitation",
    "digital",
    "rsvp",
    "nextjs",
    "typescript",
    "tailwind",
    "responsive",
    "glassmorphism",
    "modern"
  ],
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "type-check": "tsc --noEmit",
