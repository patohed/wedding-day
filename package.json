{
  "name": "wedding-day",
  "version": "1.0.0",
  "description": "A modern, customizable digital wedding invitation app built with Next.js 15, TypeScript, and beautiful glassmorphism UI",
  "private": false,
  "author": {
    "name": "Wedding Day Team",
    "email": "hello@wedding-day.dev",
